#!/bin/sh

# Enable the desktop accessibility bridge for future application launches.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface toolkit-accessibility true >/dev/null 2>&1 || true
fi

export NO_AT_BRIDGE=0
export QT_ACCESSIBILITY=1

dbus-update-activation-environment --systemd     NO_AT_BRIDGE=0     QT_ACCESSIBILITY=1     >/dev/null 2>&1 || true

systemctl --user import-environment     NO_AT_BRIDGE     QT_ACCESSIBILITY     >/dev/null 2>&1 || true

exec /usr/bin/python3 /usr/lib/q704-zorin-keyboard/q704_osk.py "$@"
